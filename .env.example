# Admin login
# Sessions are signed with a key built from both values below, so changing
# ADMIN_PASSWORD logs every staff member out. ADMIN_SESSION_SECRET should be a
# long random string (e.g. `openssl rand -hex 32`); without it the key rests on
# the password alone.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Supabase (Project Settings -> API in the Supabase dashboard)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Contact form email (Resend)
RESEND_API_KEY=
EMAIL_TO=
EMAIL_FROM=

# Cloudflare R2: listing photos, signed agreements and the daily database backup.
# Until all six are set, files stay on Supabase. R2 dashboard: create the two
# buckets, connect R2_PHOTOS_URL as the photos bucket's custom domain, and make an
# API token with Object Read & Write on both buckets.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PHOTOS_BUCKET=gold-photos
R2_PRIVATE_BUCKET=gold-private
R2_PHOTOS_URL=https://photos.gold-eg.com
