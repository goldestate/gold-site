# Admin login
# Sessions are signed with a key built from both values below, so changing
# ADMIN_PASSWORD logs every staff member out. ADMIN_SESSION_SECRET should be a
# long random string (e.g. `openssl rand -hex 32`); without it the key rests on
# the password alone.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Supabase (Project Settings -> API in the Supabase dashboard)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Contact form email (Resend)
RESEND_API_KEY=
EMAIL_TO=
EMAIL_FROM=
